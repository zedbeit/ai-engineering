+def test_list_category_shows_only_that_category(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    db = tmp_path / "t.db"
+    main(["add", "12.50", "food", "--date", "2026-11-10"], db_path=db)
+    main(["add", "3.20", "transport", "--date", "2026-11-11"], db_path=db)
+    capsys.readouterr()  # discard the "Added ..." lines
+
+    assert main(["list", "--category", "food"], db_path=db) == 0
+    out = capsys.readouterr().out
+    assert "12.50 food" in out
+    assert "transport" not in out
+
+
+def test_list_category_with_no_matches(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    db = tmp_path / "t.db"
+    main(["add", "12.50", "food", "--date", "2026-11-10"], db_path=db)
+    capsys.readouterr()
+
+    assert main(["list", "--category", "rent"], db_path=db) == 0
