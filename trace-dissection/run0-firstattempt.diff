diff --git a/expense-tracker/tests/test_cli.py b/expense-tracker/tests/test_cli.py
index fac1c97..0bc957d 100644
--- a/expense-tracker/tests/test_cli.py
+++ b/expense-tracker/tests/test_cli.py
@@ -78,3 +78,43 @@ def test_unknown_command_exits_2(tmp_path: Path) -> None:
     with pytest.raises(SystemExit) as e:
         main(["fly"], db_path=tmp_path / "t.db")
     assert e.value.code == 2
+
+
+def test_list_category_shows_only_that_category(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    db = tmp_path / "t.db"
+    main(["add", "12.50", "food", "--date", "2026-11-10"], db_path=db)
+    main(["add", "3.20", "transport", "--date", "2026-11-11"], db_path=db)
+    capsys.readouterr()  # discard the "Added ..." lines
+
+    assert main(["list", "--category", "food"], db_path=db) == 0
+    out = capsys.readouterr().out
+    assert "food" in out
+    assert "12.50" in out
+    assert "transport" not in out
+
+
+def test_list_category_with_no_matches(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    db = tmp_path / "t.db"
+    main(["add", "12.50", "food", "--date", "2026-11-10"], db_path=db)
+    capsys.readouterr()
+
+    assert main(["list", "--category", "rent"], db_path=db) == 0
+    assert "No expenses in category 'rent'." in capsys.readouterr().out
+
+
+def test_list_without_category_shows_everything(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    db = tmp_path / "t.db"
+    main(["add", "12.50", "food", "--date", "2026-11-10"], db_path=db)
+    main(["add", "3.20", "transport", "--date", "2026-11-11"], db_path=db)
+    capsys.readouterr()
+
+    assert main(["list"], db_path=db) == 0
+    out = capsys.readouterr().out
+    assert "food" in out
+    assert "transport" in out
